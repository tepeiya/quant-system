{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "healthcheckPath": "/auth/login",
    "healthcheckTimeout": 30,
    "env": {
      "ALPACA_API_KEY_ID": "",
      "ALPACA_SECRET_KEY": "",
      "TIINGO_API_KEY": "",
      "FRED_API_KEY": "",
      "PUSHPLUS_TOKEN": ""
    }
  }
}
